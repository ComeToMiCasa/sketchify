{
  "name": "postcss-sketchify",
  "version": "0.0.0",
  "description": "PostCSS plugin that turns plain CSS borders and fills into hand-drawn sketches without changing layout",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "postcss",
    "postcss-plugin",
    "sketch",
    "hand-drawn",
    "rough"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.7",
    "postcss-value-parser": "^4.2.0",
    "roughjs": "^4.6.6"
  }
}
