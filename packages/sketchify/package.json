{
  "name": "sketchify",
  "version": "0.1.0",
  "description": "The command line for postcss-sketchify, a PostCSS plugin that turns the borders, fills and underlines of plain CSS into hand-drawn SVG sketches at build time, without changing layout",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComeToMiCasa/sketchify.git",
    "directory": "packages/sketchify"
  },
  "homepage": "https://cometomicasa.github.io/sketchify/",
  "bugs": {
    "url": "https://github.com/ComeToMiCasa/sketchify/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sketchify": "./bin.js"
  },
  "files": [
    "bin.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "css",
    "sketch",
    "hand-drawn",
    "rough",
    "cli",
    "postcss"
  ],
  "dependencies": {
    "postcss": "^8.4.0",
    "postcss-sketchify": "^0.1.0"
  }
}
